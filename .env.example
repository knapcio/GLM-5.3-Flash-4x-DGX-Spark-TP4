# Four Sparks: ssh aliases and fabric IPs (rank 0 first = head, API on HOST_BIND:PORT)
HOSTS="Spark_01 Spark_02 Spark_03 Spark_04"
IPS="10.100.96.2 10.100.96.1 10.100.96.3 10.100.96.4"
FABRIC_IFACE=enp1s0f0np0
IB_HCA=rocep1s0f0
NCCL_IB_GID_INDEX=3
# NCCL 2.30.7 built for the host (see docs/nccl.md); leave empty to use the image's NCCL
NCCL_HOST_DIR=/home/knapcio/nccl-2.30.7
IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6
# NVFP4 weights and the DFlash2 drafter, present on every node at the same path
MODEL_DIR=/home/knapcio/models/RedHatAI/GLM-5.3-Flash-NVFP4   # or LibertAIDAI/GLM-5.3-Flash-NVFP4 (ModelOpt), equal within noise
DRAFT_DIR=/home/knapcio/models/incoai/GLM-5.3-Flash-DFlash2
MOE_BACKEND=marlin            # triton for the official FP8 checkpoint
SERVED_NAME=GLM-5.3-Flash
CTN=glm53-nvfp4
OVERLAY_REMOTE=/home/knapcio/glm53-flash-4x-spark
MAX_MODEL_LEN=262144
KV_BYTES=12884901888          # 12 GiB FP8 KV per rank
MAX_SEQS=4
BATCHED_TOKENS=4096
K_HI=7                        # adaptive draft length per request in {K_LO, K_HI}
K_LO=3
CAPTURE_SIZES="[1, 2, 4, 6, 8, 12, 16, 18, 24, 32]"
CAPTURE_MAX=32
DEFAULT_EFFORT=high
HOST_BIND=127.0.0.1
PORT=8093
PREWARM=1                     # host-side shard prewarm during weight loading (scripts/prewarm.py)
