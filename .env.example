# Run start.sh on the head. Replace management names, fabric IPs, user and paths.
# Use absolute Linux paths without whitespace. Keep management access separate from RoCE.
HOSTS="local spark-02 spark-03 spark-04"
SSH_OPTS="-o BatchMode=yes"
IPS="10.100.96.2 10.100.96.1 10.100.96.3 10.100.96.4"
FABRIC_IFACE=enp1s0f0np0
IB_HCA=rocep1s0f0,roceP2p1s0f0
NCCL_IB_GID_INDEX=3
NCCL_HOST_DIR="$HOME/nccl-2.30.7"
IMAGE=glm53-roce:v11-b58f34ea
MODEL_DIR="$HOME/models/glm-quant-mix/lossless8"
DRAFT_DIR="$HOME/models/incoai/GLM-5.3-Flash-DFlash2-fp8blk"
CTN=glm53-lvkp-s-l2
OVERLAY_REMOTE="$HOME/glm53-flash-4x-spark"
source profiles/current.env
