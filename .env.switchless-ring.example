# Switchless ring with RoCEnante on the hardware-forwarded opposite-node paths.
# Copy to a private configuration file only after editing every site field; four ranks
# in physical ring order. No fabric configuration, library build or deployment is
# performed by this file. Prerequisites (docs/switchless.md): the netfilter/hairpin
# mesh installed and active on all four hosts — its plan writes the peer maps used
# below — and an image built from Dockerfile.roce, which carries b12x.comm.roce_ring.
# The plain ring without RoCEnante is .env.switchless.example.
HOSTS="local rank1 rank2 rank3"
SSH_OPTS="-o BatchMode=yes"
# Reachable management/bootstrap addresses, separate from the RDMA subnets.
IPS="192.0.2.10 192.0.2.11 192.0.2.12 192.0.2.13"
FABRIC_IFACE=eth0
# All four PF devices of the qualified four-PF topology, in B12X_ROCE_HCA order.
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_HOST_DIR=/opt/switchless-nccl/lib
# SHA256 of YOUR previously built/verified patched libnccl.so.2.30.7 on all four hosts.
# Stock NCCL is insufficient; see docs/switchless.md for the patch contract.
SWITCHLESS_NCCL_SHA256=REPLACE_WITH_VERIFIED_LIBRARY_SHA256
SWITCHLESS_ADDR_RANGE=10.100.224.0/22
SWITCHLESS_SUBNET_PREFIX_LEN=24
TRANSPORT=switchless
# RoCEnante over the ring: the mesh plan's env.txt value, four ';'-separated maps in
# TP rank order (peer=path0/path1, absolute HCA indices). Required with ring=1 and
# validated before any remote action; whitespace is rejected.
SWITCHLESS_ROCE_RING=1
SWITCHLESS_ROCE_PEER_HCA_MAPS="1=0/2,2=0/3,3=1/3;0=1/3,2=0/2,3=0/3;0=1/2,1=1/3,3=0/2;0=0/2,1=1/2,2=1/3"
# Optional: sizes must fit the hairpin queue the mesh install reports. The defaults
# below are the cap for queue size 8192 (256 KiB); at queue 1024 they must be 81920.
#SWITCHLESS_ROCE_MAX_SIZE=262144
#SWITCHLESS_ROCE_GATHER_MAX_SIZE=262144
IMAGE=glm53-roce:v12-ring-20261001
MODEL_DIR="$HOME/models/glm-quant-mix/lossless8"
DRAFT_DIR="$HOME/models/incoai/GLM-5.3-Flash-DFlash2-fp8blk"
CTN=glm53-switchless-ring
OVERLAY_REMOTE="$HOME/glm53-flash-switchless-ring"
source profiles/current.env
