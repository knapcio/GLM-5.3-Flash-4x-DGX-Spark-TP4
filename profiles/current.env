# Accepted LVKP-S-L2, 2026-09-26. Source after the operator's .env.
# Hardware paths/hosts/image are supplied by .env; this file defines serving semantics.
MOE_BACKEND=marlin
SERVED_NAME=GLM-5.3-Flash-FP8
MAX_MODEL_LEN=262144
KV_BYTES=25769803776
MAX_SEQS=32
BATCHED_TOKENS=6912
K_HI=7
K_LO=3
SPEC_TABLE='[[1, 1, 7], [2, 2, 5], [3, 32, 3]]'
CAPTURE_SIZES='[1, 2, 4, 6, 8, 12, 16, 18, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256]'
CAPTURE_MAX=256
DEFAULT_EFFORT=high
HOST_BIND=127.0.0.1
PORT=8093
GPU_UTIL=0.78
MM_IMAGES=16
MM_CACHE_GB=4
GLM5NEXT_PATCH=1
GLM_KPOOL_FIX=1
LOAD_FORMAT=
PREWARM=0
BOOT_WARM=0
COMPACT_MEM=0
FI_CACHE_PERSIST=1
SCHEDULER_CLS=glm_levers_sched.LeversScheduler
EXTRA_ARGS='--linear-backend marlin'
EXTRA_ENV='VLLM_DISABLED_KERNELS=FlashInferCutlassMxfp8LinearKernel,FlashInferCutedslMxfp8LinearKernel QMIX_FP8_BLOCK=1 VLLM_TEST_FORCE_FP8_MARLIN=1 QMIX_DEBUG_LAYERS=1 GLM_FAST_LOAD=1 TRITON_CACHE_AUTOTUNING=1 TILELANG_CACHE_DIR=/cache/tilelang GLM_ROCE_ALLREDUCE=1 GLM_DS_SPLIT=fc:128,qkv_a:64,wq_b:16 GLM_DS_DRAFT_HEAD_FP8=1 GLM_DS_TOPK_ONE_GATHER=1 GLM_KDA_STASH=1 GLM_TARGET_VOCAB_ARGMAX=1 GLM_LV_SPLIT_FIX=1 GLM_LV_SPLIT_INEXACT=fc GLM_LV_ARGMAX_MINTOK=1 GLM_LV_DRAFT_FP8_KV=1 GLM_LV_MODE=batch-uniform SPEC_PROBE_CONTROL=/cache/levers_policy_final.json GLM_KDA_STASH_NOCOPY=1 GLM_KDA_FLAG_FUSED=share GLM_L2_PREFETCH=1 GLM_L2_PREFETCH_AR=1 GLM_L2_PREFETCH_MB=6 GLM_L2_PREFETCH_AR_MB=4 GLM_L2_PREFETCH_MAXTOK=32 GLM_L2_PREFETCH_LOG_EVERY=50000'

# Keep RoCEnante on the same explicitly selected HCA set as NCCL.
EXTRA_ENV="$EXTRA_ENV B12X_ROCE_HCA=$IB_HCA"
